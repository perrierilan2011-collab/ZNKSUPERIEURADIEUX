local function ProcessPotentialEggInstance(inst)
    if not inst or not inst.Parent then return end
    if not (inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Folder")) then return end
    if not IsValidEggName(inst.Name) then return end
    if IsEggOwnedByOtherPlayer(inst) then return end
    local pos = GetEggPosition(inst)
    if IsInOwnBaseZone(pos) then return end
    local nameLower = inst.Name:lower()
    local priority, rarity = GetEggPriority(inst, nameLower)
    if AddEggWindowEntry then
        AddEggWindowEntry({instance = inst, name = inst.Name, rarity = rarity, priority = priority})
    end
end

