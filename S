local DiscoveredEggRarity = {}
local RarityDiscoveryStats = { ModulesScanned = 0, EggsFound = 0, ModuleNamesScanned = {} }

local function SafeRequire(moduleScript)
    local ok, result = pcall(function() return require(moduleScript) end)
    if ok then return result end
    return nil
end

local function ScanTableForEggData(tbl, depth)
    if depth > 5 or typeof(tbl) ~= "table" then return end
    for key, value in pairs(tbl) do
        if typeof(value) == "table" then
            local rarity = value.Rarity or value.rarity or value.Tier or value.tier
            local chance = value.Chance or value.chance or value.Weight or value.weight
                or value.Odds or value.odds or value.Probability or value.probability
            local nameGuess = value.Name or value.name or (typeof(key) == "string" and key) or nil

            if rarity and typeof(rarity) == "string" and nameGuess and typeof(nameGuess) == "string" then
                local key2 = nameGuess:lower()
                if key2:find("egg") then
                    DiscoveredEggRarity[key2] = DiscoveredEggRarity[key2] or {}
                    DiscoveredEggRarity[key2].rarity = rarity
                    if typeof(chance) == "number" then
                        DiscoveredEggRarity[key2].chance = chance
                    end
                end
            end

            pcall(function() ScanTableForEggData(value, depth + 1) end)
        elseif typeof(value) == "string" and typeof(key) == "string" then
            local keyLower = key:lower()
            if keyLower:find("egg") and RARITY_PRIORITY[value:lower()] then
                DiscoveredEggRarity[keyLower] = DiscoveredEggRarity[keyLower] or {}
                DiscoveredEggRarity[keyLower].rarity = value
            end
        end
    end
end

local function FinalizeDiscoveredRarities()
    local withChance = {}
    for name, data in pairs(DiscoveredEggRarity) do
        if data.chance then table.insert(withChance, {name = name, chance = data.chance}) end
    end
    table.sort(withChance, function(a, b) return a.chance < b.chance end)
    for i, entry in ipairs(withChance) do
        ModuleRarityMap[entry.name] = {
            rarity = DiscoveredEggRarity[entry.name].rarity,
            priority = i,
        }
    end

    for name, data in pairs(DiscoveredEggRarity) do
        if not ModuleRarityMap[name] and data.rarity then
            local rLower = data.rarity:lower()
            local p = RARITY_PRIORITY[rLower] or UNKNOWN_PRIORITY
            ModuleRarityMap[name] = { rarity = data.rarity, priority = p }
        end
    end

    local count = 0
    for _ in pairs(ModuleRarityMap) do count = count + 1 end
    RarityDiscoveryStats.EggsFound = count
end

local function DiscoverGameEggRarities()
    RarityDiscoveryStats.ModulesScanned = 0
    RarityDiscoveryStats.ModuleNamesScanned = {}
    pcall(function()
        local locations = {ReplicatedStorage, ReplicatedFirst}
        local moduleKeywords = {"egg","pet","rarity","rarities","data","config","item","shop"}
        for _, loc in pairs(locations) do
            pcall(function()
                for _, desc in pairs(loc:GetDescendants()) do
                    if desc:IsA("ModuleScript") then
                        local nameLower = desc.Name:lower()
                        local matches = false
                        for _, kw in pairs(moduleKeywords) do
                            if nameLower:find(kw) then matches = true break end
                        end
                        if matches then
                            RarityDiscoveryStats.ModulesScanned = RarityDiscoveryStats.ModulesScanned + 1
                            table.insert(RarityDiscoveryStats.ModuleNamesScanned, desc:GetFullName())
                            local result = SafeRequire(desc)
                            if result then
                                pcall(function() ScanTableForEggData(result, 0) end)
                            end
                        end
                    end
                end
            end)
        end
    end)
    FinalizeDiscoveredRarities()
end

