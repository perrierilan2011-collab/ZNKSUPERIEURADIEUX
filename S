-- =====================================================

local function GetInstanceFullPath(inst)
    local ok, path = pcall(function() return inst:GetFullName() end)
    if ok then return path end
    return inst.Name
end

local function GenerateDebugReport()
    local lines = {}
    table.insert(lines, "===== RAPPORT DEBUG OEUFS =====")
    table.insert(lines, "PlaceId: "..tostring(game.PlaceId))
    table.insert(lines, "")

    table.insert(lines, "--- Instances contenant 'egg' dans Workspace ---")
    local foundAny = false
    pcall(function()
        for _, inst in pairs(Workspace:GetDescendants()) do
            if inst.Name:lower():find("egg") then
                foundAny = true
                local validName = IsValidEggName(inst.Name)
                local ownedOther = false
                local pos = nil
                local inBase = false
                local priority, rarity = "N/A", "N/A"
                pcall(function() ownedOther = IsEggOwnedByOtherPlayer(inst) end)
                pcall(function() pos = GetEggPosition(inst) end)
                pcall(function() inBase = IsInOwnBaseZone(pos) end)
                if validName then
                    pcall(function() priority, rarity = GetEggPriority(inst, inst.Name:lower()) end)
                end
                table.insert(lines, string.format(
                    "Nom='%s' Class=%s ValidName=%s OwnedByOther=%s DansZoneBase=%s Priority=%s Rarity=%s Path=%s",
                    inst.Name, inst.ClassName, tostring(validName), tostring(ownedOther), tostring(inBase), tostring(priority), tostring(rarity), GetInstanceFullPath(inst)
                ))
            end
        end
    end)
    if not foundAny then table.insert(lines, "(Aucune instance contenant 'egg' trouvee)") end

    table.insert(lines, "")
    table.insert(lines, "--- ModuleScripts scannes ---")
    table.insert(lines, "Nombre scanne: "..tostring(RarityDiscoveryStats.ModulesScanned))
    table.insert(lines, "Oeufs avec rarete identifiee: "..tostring(RarityDiscoveryStats.EggsFound))
    for _, n in pairs(RarityDiscoveryStats.ModuleNamesScanned) do
        table.insert(lines, "  Module: "..n)
    end

    table.insert(lines, "")
    table.insert(lines, "--- Raretes trouvees via modules du jeu ---")
    for name, data in pairs(ModuleRarityMap) do
        table.insert(lines, string.format("  %s -> rarity=%s priority=%s", name, tostring(data.rarity), tostring(data.priority)))
    end

    table.insert(lines, "")
    table.insert(lines, "--- Raretes apprises via chat/logs ---")
    for name, data in pairs(ChatLearnedRarityMap) do
        table.insert(lines, string.format("  %s -> rarity=%s priority=%s", name, tostring(data.rarity), tostring(data.priority)))
    end

    table.insert(lines, "")
    table.insert(lines, "--- Entrees actuellement dans la fenetre TP ---")
    for _, entry in ipairs(EggWindowState.EntriesOrder) do
        table.insert(lines, string.format("  %s priority=%s visible=%s", entry.name, tostring(entry.priority), tostring(entry.button and entry.button.Visible)))
    end

    table.insert(lines, "")
    table.insert(lines, "--- Base / Exclusion ---")
    table.insert(lines, "Base definie: "..tostring(AutoFarmConfig.BaseCFrame ~= nil))
    table.insert(lines, "Rayon exclusion: "..tostring(AutoFarmConfig.ExclusionRadius))

    return table.concat(lines, "\n")
end

