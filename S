local RARITY_PRIORITY = {
    secret = 1, exclusive = 1, divine = 1, celestial = 1, infinity = 1,
    mythical = 2, mythic = 2, godly = 2, ancient = 2, omega = 2, void = 2, cosmic = 2, rainbow = 2,
    legendary = 3, limited = 3, exotic = 3, unique = 3, golden = 3, chroma = 3,
    epic = 4, special = 4, super = 4, premium = 4, shiny = 4,
    rare = 5, ultra = 5,
    uncommon = 6,
    common = 7,
}
local UNKNOWN_PRIORITY = 999

local ModuleRarityMap = {}
local ChatLearnedRarityMap = {}

-- Nom valide : contient "egg" (pas forcement a la fin) -- version plus permissive
local function IsValidEggName(name)
    if not name or typeof(name) ~= "string" then return false end
    local lower = name:lower()
    return lower:find("egg") ~= nil
end

local function GetEggRarityFromInstance(eggInstance)
    local rarity = nil
    pcall(function()
        local attrs = eggInstance:GetAttributes()
        for k, v in pairs(attrs) do
            if tostring(k):lower():find("rar") then rarity = tostring(v) end
        end
    end)
    if not rarity then
        pcall(function()
            for _, sub in pairs(eggInstance:GetChildren()) do
                if (sub:IsA("StringValue") or sub:IsA("IntValue") or sub:IsA("NumberValue")) and sub.Name:lower():find("rar") then
                    rarity = tostring(sub.Value)
                end
            end
        end)
    end
    return rarity
end

local function GetEggPriority(eggInstance, nameLower)
    local rarity = GetEggRarityFromInstance(eggInstance)
    if rarity then
        local rLower = rarity:lower()
        if RARITY_PRIORITY[rLower] then
            return RARITY_PRIORITY[rLower], rarity
        end
        return UNKNOWN_PRIORITY, rarity
    end

    local moduleData = ModuleRarityMap[nameLower]
    if moduleData then
        return moduleData.priority, moduleData.rarity
    end

    local chatData = ChatLearnedRarityMap[nameLower]
    if chatData then
        return chatData.priority, chatData.rarity
    end

    return UNKNOWN_PRIORITY, "Unknown"
end

local function IsEggOwnedByOtherPlayer(eggInstance)
    local current = eggInstance
    for i = 1, 10 do
        if not current or current == Workspace then break end
        local isOwnedByOther = false
        pcall(function()
            local ownerAttr = current:GetAttribute("Owner")
            if typeof(ownerAttr) == "Instance" and ownerAttr:IsA("Player") and ownerAttr ~= LocalPlayer then
                isOwnedByOther = true
            elseif typeof(ownerAttr) == "string" and ownerAttr ~= "" and ownerAttr ~= LocalPlayer.Name then
                isOwnedByOther = true
            end

            local ownerId = current:GetAttribute("OwnerUserId") or current:GetAttribute("UserId") or current:GetAttribute("OwnerId")
            if ownerId and tonumber(ownerId) and tonumber(ownerId) ~= LocalPlayer.UserId then
                isOwnedByOther = true
            end

            local ownerChild = current:FindFirstChild("Owner")
            if ownerChild then
                if ownerChild:IsA("ObjectValue") and ownerChild.Value and ownerChild.Value:IsA("Player") and ownerChild.Value ~= LocalPlayer then
                    isOwnedByOther = true
                elseif ownerChild:IsA("StringValue") and ownerChild.Value ~= "" and ownerChild.Value ~= LocalPlayer.Name then
                    isOwnedByOther = true
                end
            end

            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and current.Name == p.Name then
                    isOwnedByOther = true
                end
            end
        end)
        if isOwnedByOther then return true end
        current = current.Parent
    end
    return false
end

local function GetEggPosition(eggInstance)
    local ok, pos = pcall(function()
        if eggInstance:IsA("BasePart") then return eggInstance.Position end
        if eggInstance:IsA("Model") then
            if eggInstance.PrimaryPart then return eggInstance.PrimaryPart.Position end
            local part = eggInstance:FindFirstChildWhichIsA("BasePart", true)
            if part then return part.Position end
        end
        return nil
    end)
    if ok then return pos end
    return nil
end

local function IsInOwnBaseZone(pos)
    if not AutoFarmConfig.BaseCFrame or not pos then return false end
    if AutoFarmConfig.ExclusionRadius <= 0 then return false end
    return (pos - AutoFarmConfig.BaseCFrame.Position).Magnitude <= AutoFarmConfig.ExclusionRadius
end

local function ScanWorkspaceEggs()
    local found = {}
    local function scan(obj, depth)
        if depth > 14 then return end
        for _, child in pairs(obj:GetChildren()) do
            pcall(function()
                if (child:IsA("Model") or child:IsA("BasePart") or child:IsA("Folder")) and IsValidEggName(child.Name) then
                    if not IsEggOwnedByOtherPlayer(child) then
                        local pos = GetEggPosition(child)
                        if not IsInOwnBaseZone(pos) then
                            local nameLower = child.Name:lower()
                            local priority, rarity = GetEggPriority(child, nameLower)
                            table.insert(found, {instance = child, name = child.Name, rarity = rarity, priority = priority})
                        end
                    end
                end
            end)
            scan(child, depth + 1)
        end
    end
    scan(Workspace, 0)
    table.sort(found, function(a, b) return a.priority < b.priority end)
    return found
end

