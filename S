local function HandleEggLogMessage(message)
    if typeof(message) ~= "string" then return end
    local lowerMsg = message:lower()

    for eggNameToken in message:gmatch("%f[%w_]+[%w_]*[Ee]gg[%w_]*") do
        if IsValidEggName(eggNameToken) then
            local key = eggNameToken:lower()

            if not ModuleRarityMap[key] then
                local foundRarityWord = nil
                local foundPriority = UNKNOWN_PRIORITY
                for rarityWord, priority in pairs(RARITY_PRIORITY) do
                    if lowerMsg:find(rarityWord, 1, true) and priority < foundPriority then
                        foundRarityWord = rarityWord
                        foundPriority = priority
                    end
                end

                ChatLearnedRarityMap[key] = {
                    rarity = foundRarityWord or "Unknown",
                    priority = foundPriority,
                }

                pcall(function()
                    if UpdateEggWindowEntryRarity then
                        UpdateEggWindowEntryRarity(key, foundRarityWord or "Unknown", foundPriority)
                    end
                end)
            end
        end
    end
end

