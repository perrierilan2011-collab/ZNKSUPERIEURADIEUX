local FlyBodyVelocity = nil
local FlyBodyGyro = nil
local NoclipConnection = nil

local function UpdateSpeed()
    local char = LocalPlayer.Character
    if not char then return end
    local h = char:FindFirstChild("Humanoid")
    if not h then return end
    if MovementConfig.Speed then
        local target = MovementConfig.SpeedValue
        local current = MovementConfig.SpeedCurrent or h.WalkSpeed
        local step = math.min(2, math.abs(target - current))
        current = current < target and current + step or target
        MovementConfig.SpeedCurrent = current
        h.WalkSpeed = current
    else
        MovementConfig.SpeedCurrent = 16
        h.WalkSpeed = 16
    end
    h.JumpPower = MovementConfig.Jump and MovementConfig.JumpValue or 50
end

local function EnableFly()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        if FlyBodyVelocity then FlyBodyVelocity:Destroy() FlyBodyVelocity = nil end
        if FlyBodyGyro then FlyBodyGyro:Destroy() FlyBodyGyro = nil end
        FlyBodyVelocity = Instance.new("BodyVelocity")
        FlyBodyVelocity.Velocity = Vector3.new(0,0,0)
        FlyBodyVelocity.MaxForce = Vector3.new(1e5,1e5,1e5)
        FlyBodyVelocity.P = 1e4
        FlyBodyVelocity.Parent = root
        FlyBodyGyro = Instance.new("BodyGyro")
        FlyBodyGyro.MaxTorque = Vector3.new(1e5,1e5,1e5)
        FlyBodyGyro.P = 1e4 FlyBodyGyro.D = 500
        FlyBodyGyro.CFrame = root.CFrame
        FlyBodyGyro.Parent = root
    end)
end

local function DisableFly()
    pcall(function()
        if FlyBodyVelocity then FlyBodyVelocity:Destroy() FlyBodyVelocity = nil end
        if FlyBodyGyro then FlyBodyGyro:Destroy() FlyBodyGyro = nil end
    end)
end

local function UpdateFly()
    pcall(function()
        if not MovementConfig.Fly or not FlyBodyVelocity or not FlyBodyGyro then return end
        local cam = Camera.CFrame
        local dir = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
        local target = dir.Magnitude > 0 and dir.Unit * MovementConfig.FlySpeed or Vector3.new(0,0,0)
        FlyBodyVelocity.Velocity = FlyBodyVelocity.Velocity:Lerp(target, 0.2)
        FlyBodyGyro.CFrame = cam
    end)
end

