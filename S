local STAMINA_KEYWORDS = {"stamina", "endurance", "energy"}

local function TrySetNumericAttribute(obj)
    if not obj then return end
    pcall(function()
        local attrs = obj:GetAttributes()
        for k, v in pairs(attrs) do
            local kl = tostring(k):lower()
            if typeof(v) == "number" then
                for _, kw in pairs(STAMINA_KEYWORDS) do
                    if kl:find(kw) then
                        pcall(function() obj:SetAttribute(k, 90) end)
                    end
                end
            end
        end
    end)
end

local function TrySetValueObjects(container)
    if not container then return end
    pcall(function()
        for _, child in pairs(container:GetDescendants()) do
            if child:IsA("NumberValue") or child:IsA("IntValue") then
                local nl = child.Name:lower()
                for _, kw in pairs(STAMINA_KEYWORDS) do
                    if nl:find(kw) then
                        pcall(function() child.Value = 90 end)
                    end
                end
            end
        end
    end)
end

local function FixStaminaAfterTeleport()
    if not StaminaFixConfig.Enabled then return end
    pcall(function()
        TrySetNumericAttribute(LocalPlayer)
        TrySetNumericAttribute(LocalPlayer.Character)

        TrySetValueObjects(LocalPlayer)
        if LocalPlayer.Character then TrySetValueObjects(LocalPlayer.Character) end

        local ls = LocalPlayer:FindFirstChild("leaderstats")
        if ls then TrySetValueObjects(ls) end

        for _, folderName in pairs({"Stats","PlayerData","Data","PlayerStats"}) do
            local f = LocalPlayer:FindFirstChild(folderName)
            if f then TrySetValueObjects(f) end
        end

        local remotes = ScanAllRemotes()
        for _, r in pairs(remotes) do
            local nl = r.Name:lower()
            for _, kw in pairs(STAMINA_KEYWORDS) do
                if nl:find(kw) then
                    pcall(function()
                        if r:IsA("RemoteEvent") then
                            r:FireServer(90)
                        elseif r:IsA("RemoteFunction") then
                            r:InvokeServer(90)
                        end
                    end)
                end
            end
        end
    end)
end

