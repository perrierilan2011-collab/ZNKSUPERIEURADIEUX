        if entry.instance and entry.instance.Parent then
            local nameLower = entry.name:lower()
            local priority, rarity = GetEggPriority(entry.instance, nameLower)
            if priority ~= entry.priority then
                entry.priority = priority
                changed = true
                local btn = entry.button
                if btn then
                    local rarityLabel = btn:FindFirstChild("RarityLabel")
                    if rarityLabel then rarityLabel.Text = rarity end
                end
            end
        end
    end
    if changed then
        table.sort(EggWindowState.EntriesOrder, function(a, b) return a.priority < b.priority end)
        ReflowEggWindow()
        for _, entry in ipairs(EggWindowState.EntriesOrder) do
            if entry.button then
                entry.button.Visible = (not EggWindowState.BetterFilterEnabled) or (entry.priority <= BETTER_THRESHOLD)
            end
        end
    end
end

local function RefreshEggWindowForZoneChange()
    local toRemove = {}
    for _, entry in ipairs(EggWindowState.EntriesOrder) do
        local pos = GetEggPosition(entry.instance)
        if IsInOwnBaseZone(pos) then
            table.insert(toRemove, entry.instance)
        end
    end
    for _, inst in ipairs(toRemove) do RemoveEggWindowEntry(inst) end
    PopulateEggWindowFromScan()
end

