local function ScanArgsForEggs(...)
    local args = {...}
    for _, arg in pairs(args) do
        pcall(function()
            if typeof(arg) == "Instance" then
                ProcessPotentialEggInstance(arg)
                if arg:IsA("Folder") or arg:IsA("Model") then
                    for _, d in pairs(arg:GetDescendants()) do
                        ProcessPotentialEggInstance(d)
                    end
                end
            elseif typeof(arg) == "string" then
                HandleEggLogMessage(arg)
            elseif typeof(arg) == "table" then
                for k, v in pairs(arg) do
                    if typeof(v) == "Instance" then
                        ProcessPotentialEggInstance(v)
                    elseif typeof(v) == "string" then
                        HandleEggLogMessage(v)
                    end
                end
            end
        end)
    end
end

local function HookRemoteForEggs(remote)
    if HookedRemotes[remote] then return end
    if not remote:IsA("RemoteEvent") then return end
    HookedRemotes[remote] = true
    pcall(function()
        AddConnection(remote.OnClientEvent:Connect(function(...)
            pcall(ScanArgsForEggs, ...)
        end))
    end)
end

