local function FindRemoteEvent(name)
    local function search(obj)
        for _, child in pairs(obj:GetChildren()) do
            if child:IsA("RemoteEvent") and child.Name:lower():find(name:lower()) then return child end
            local found = search(child)
            if found then return found end
        end
    end
    return search(game)
end

local function FindRemoteFunction(name)
    local function search(obj)
        for _, child in pairs(obj:GetChildren()) do
            if child:IsA("RemoteFunction") and child.Name:lower():find(name:lower()) then return child end
            local found = search(child)
            if found then return found end
        end
    end
    return search(game)
end

local function KillPlayerUniversal(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    local damageRemote = FindRemoteEvent("Damage") or FindRemoteEvent("TakeDamage") or FindRemoteEvent("Hit") or FindRemoteEvent("Attack")
    if damageRemote then pcall(function() damageRemote:FireServer(targetPlayer, 999999) end) end
    local killRemote = FindRemoteEvent("Kill") or FindRemoteEvent("Death") or FindRemoteEvent("OnDeath")
    if killRemote then pcall(function() killRemote:FireServer(targetPlayer) end) end
    local damageFunc = FindRemoteFunction("Damage") or FindRemoteFunction("TakeDamage")
    if damageFunc then pcall(function() damageFunc:InvokeServer(targetPlayer, 999999) end) end
    pcall(function()
        local humanoid = targetPlayer.Character:FindFirstChild("Humanoid")
        if humanoid then humanoid.Health = 0 end
    end)
    local function searchAndFire(obj)
        for _, child in pairs(obj:GetChildren()) do
            if child:IsA("RemoteEvent") then
                pcall(function() child:FireServer(targetPlayer, 999999) end)
                pcall(function() child:FireServer(targetPlayer) end)
            end
            searchAndFire(child)
        end
    end
    searchAndFire(game)
    return true
end

