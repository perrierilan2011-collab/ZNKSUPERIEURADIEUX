-- REMOTE HIT SYSTEM
-- =====================================================

local function RemoteHitPlayer(targetPlayer, damage)
    if not targetPlayer or not targetPlayer.Character then return 0 end
    local char = targetPlayer.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local humanoid = char:FindFirstChild("Humanoid")
    if not root then return 0 end

    local fired = 0
    local hitPatterns = {}

    table.insert(hitPatterns, function(r) if r:IsA("RemoteEvent") then r:FireServer(targetPlayer) end end)
    table.insert(hitPatterns, function(r) if r:IsA("RemoteEvent") then r:FireServer(targetPlayer, damage) end end)
    table.insert(hitPatterns, function(r) if r:IsA("RemoteEvent") then r:FireServer(char, damage) end end)
    table.insert(hitPatterns, function(r) if humanoid and r:IsA("RemoteEvent") then r:FireServer(humanoid, damage) end end)
    table.insert(hitPatterns, function(r) if r:IsA("RemoteEvent") then r:FireServer(root, damage) end end)
    table.insert(hitPatterns, function(r)
        if r:IsA("RemoteEvent") then
            r:FireServer({Target=targetPlayer, Damage=damage, Hit=root, Position=root.Position})
        end
    end)
    table.insert(hitPatterns, function(r)
        if r:IsA("RemoteEvent") then r:FireServer({Character=char, Damage=damage, Part=root}) end
    end)
    table.insert(hitPatterns, function(r) if r:IsA("RemoteEvent") then r:FireServer(root.Position, targetPlayer, damage) end end)
    table.insert(hitPatterns, function(r) if r:IsA("RemoteEvent") then r:FireServer(targetPlayer, root.Position, damage) end end)
    table.insert(hitPatterns, function(r) if r:IsA("RemoteEvent") then r:FireServer(root) end end)
    table.insert(hitPatterns, function(r) if r:IsA("RemoteFunction") then pcall(function() r:InvokeServer(targetPlayer, damage) end) end end)
    table.insert(hitPatterns, function(r) if r:IsA("RemoteFunction") then pcall(function() r:InvokeServer({Target=targetPlayer, Damage=damage, Hit=root}) end) end end)
    table.insert(hitPatterns, function(r)
        if r:IsA("RemoteEvent") then
            r:FireServer({Instance=root, Position=root.Position, Normal=Vector3.new(0,1,0), Material=Enum.Material.SmoothPlastic}, damage)
        end
    end)
    table.insert(hitPatterns, function(r)
        if r:IsA("RemoteEvent") then
            r:FireServer("Hit", targetPlayer, damage)
            r:FireServer("Damage", targetPlayer, damage)
            r:FireServer("Attack", targetPlayer, damage)
        end
    end)
    table.insert(hitPatterns, function(r) if r:IsA("RemoteEvent") then r:FireServer(targetPlayer.UserId, damage) end end)
    table.insert(hitPatterns, function(r) if r:IsA("RemoteEvent") then r:FireServer(targetPlayer, root, damage) end end)
    table.insert(hitPatterns, function(r) if r:IsA("RemoteEvent") then r:FireServer(root, targetPlayer, damage) end end)
    table.insert(hitPatterns, function(r)
        if r:IsA("RemoteEvent") then
            r:FireServer({Player=targetPlayer, Character=char, HitPart=root, HitPosition=root.Position, Damage=damage})
        end
    end)
    table.insert(hitPatterns, function(r)
        if r:IsA("RemoteEvent") then r:FireServer(targetPlayer, {Damage=damage, Part=root, Position=root.Position}) end
    end)

    local allRemotes = ScanAllRemotes()
    local hitKeywords = {
        "hit","damage","hurt","attack","swing","melee","strike","punch","kick",
        "bat","sword","knife","gun","shoot","fire","blast","smash","bash",
        "dps","dealdamage","takedamage","onhit","onattack","dmg","dealDmg",
        "ragdoll","stun","knockback","wound","injure","combat","fight","weapon",
        "tool","slash","stab","shoot","bullet","projectile"
    }

    local priorityRemotes = {}
    local otherRemotes = {}

    for _, remote in pairs(allRemotes) do
        local nameLower = remote.Name:lower()
        local isPriority = false
        for _, kw in pairs(hitKeywords) do
            if nameLower:find(kw) then isPriority = true break end
        end
        if isPriority then table.insert(priorityRemotes, remote)
        else table.insert(otherRemotes, remote) end
    end

    for _, remote in pairs(priorityRemotes) do
        for _, pattern in pairs(hitPatterns) do
            pcall(pattern, remote)
            fired = fired + 1
        end
    end

    for _, remote in pairs(otherRemotes) do
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(targetPlayer, damage)
                remote:FireServer(char, damage)
                remote:FireServer(root, damage)
                remote:FireServer(targetPlayer)
            end
        end)
        fired = fired + 1
    end

    pcall(function()
        if humanoid then humanoid.Health = math.max(0, humanoid.Health - damage) end
    end)

    return fired
end

local RemoteHitActive = false

local function StartRemoteHit(targetPlayer, damage, repeats)
    if RemoteHitActive then return end
