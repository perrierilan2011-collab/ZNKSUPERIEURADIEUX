    for _, entry in ipairs(EggWindowState.EntriesOrder) do
        if entry.name:lower() == nameLower and entry.priority ~= priority then
            entry.priority = priority
            changed = true
            local btn = entry.button
            if btn then
                local rarityLabel = btn:FindFirstChild("RarityLabel")
                if rarityLabel then rarityLabel.Text = rarity end
            end
        end
    end
    if changed then
        table.sort(EggWindowState.EntriesOrder, function(a, b) return a.priority < b.priority end)
        ReflowEggWindow()
        for _, entry in ipairs(EggWindowState.EntriesOrder) do
            if entry.button then
                entry.button.Visible = (not EggWindowState.BetterFilterEnabled) or (entry.priority <= BETTER_THRESHOLD)
            end
        end
    end
end

