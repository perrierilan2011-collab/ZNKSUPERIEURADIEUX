local function GetPlayerNamesSorted()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local dist = 0
            pcall(function()
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local lr = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if lr then dist = math.floor((player.Character.HumanoidRootPart.Position-lr.Position).Magnitude) end
                end
            end)
            table.insert(list, {name=player.Name, dist=dist})
        end
    end
    table.sort(list, function(a,b) return a.dist < b.dist end)
    local names = {}
    for _, d in ipairs(list) do table.insert(names, d.name.." ("..d.dist.."m)") end
    return names
end

