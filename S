AddConnection(RunService.RenderStepped:Connect(function()
    pcall(function()
        FPSCounter = FPSCounter + 1
        if tick() - LastFPSUpdate >= 1 then
            FPSText.Text = FPSCounter.." FPS"
            FPSCounter = 0 LastFPSUpdate = tick()
        end
        if MovementConfig.Fly then UpdateFly() end
        UpdateSpeed()
        if InvisibilityConfig.Enabled then EnableInvisibility() end
    end)
end))

